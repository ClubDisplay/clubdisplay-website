---
import BaseLayout from "../layouts/BaseLayout.astro";
import FAQ from "../components/FAQ.astro";

const faqItems = [
  {
    q: "Wat is narrowcasting?",
    a: "Narrowcasting is het gericht uitzenden van informatie via digitale schermen. Het wordt gebruikt voor communicatie, marketing en entertainment in onder andere winkels, hotels, restaurants en kantoren.",
  },
  {
    q: "Welke hardware heb ik nodig voor digital signage?",
    a: "U heeft een professioneel display en een mediaspeler nodig. Bij ClubDisplay leveren wij complete pakketten inclusief LG of Samsung displays, mediaspelers, beugels, bekabeling en montage. Onze software werkt op Android en webOS.",
  },
  {
    q: "Kan ik mijn eigen content gebruiken?",
    a: "Ja, u kunt afbeeldingen, video's, websites, PDF's, live feeds en sociale media toevoegen. U kunt ook gebruikmaken van onze professionele templates voor een snelle start in uw huisstijl.",
  },
  {
    q: "Werkt de software in de cloud?",
    a: "Ja, ons platform is volledig cloudgebaseerd. U logt in via een webbrowser en beheert uw schermen vanaf elke locatie. De schermen hebben alleen een internetverbinding nodig.",
  },
  {
    q: "Is de software veilig?",
    a: "Ja, wij nemen beveiliging serieus. Alle communicatie is versleuteld, gebruikers hebben rolgebaseerde toegangsrechten en wij voldoen aan de AVG. Ook back-ups, monitoring en regelmatige updates horen standaard bij onze werkwijze.",
  },
  {
    q: "Wat kost een abonnement?",
    a: "De kosten zijn afhankelijk van het aantal schermen en de gewenste functionaliteiten. Onze narrowcasting software is beschikbaar vanaf €19 per maand per scherm. Bekijk onze prijzenpagina voor een overzicht of neem contact op voor een offerte op maat.",
  },
  {
    q: "Kan ik eerst 30 dagen gratis testen?",
    a: "Ja, u kunt onze software 30 dagen gratis en vrijblijvend uitproberen. Meld u aan op onze proefpagina en ontvang direct toegang tot het platform.",
  },
  {
    q: "Welke sectoren bedient ClubDisplay?",
    a: "Wij werken voor hotels en hospitality, horeca en restaurants, coffeeshops, retail, kantoren en interne communicatie, zorg, onderwijs en publieke locaties. Per sector kiezen we de schermen, software en content die passen bij de situatie.",
  },
  {
    q: "Kan ik digitale menuborden koppelen aan mijn kassasysteem?",
    a: "Ja, wij koppelen digitale menuborden aan diverse kassasystemen. Prijzen, producten en aanbiedingen worden automatisch gesynchroniseerd, zodat wijzigingen in de kassa direct op het scherm verschijnen.",
  },
  {
    q: "Biedt ClubDisplay ook installatie en support?",
    a: "Jazeker. Wij leveren niet alleen hardware en software, maar ook installatie, montage, netwerkadvies, content, training en doorlopend beheer. Na oplevering blijven we beschikbaar voor vragen, updates en onderhoud.",
  },
];
---
<BaseLayout title="Veelgestelde Vragen" description="Veelgestelde vragen over digital signage, narrowcasting en ClubDisplay. Antwoord op de meest gestelde vragen over onze producten en diensten." currentPath="/veelgestelde-vragen/">
  <div class="container page-content">
    <h1>Veelgestelde Vragen</h1>
    <p>Hieronder vindt u antwoorden op de meest gestelde vragen over onze producten en diensten. Staat uw vraag er niet bij? <a href="/contact/">Neem dan gerust contact met ons op</a>, wij helpen u graag verder.</p>
  </div>
  <FAQ items={faqItems} title="Antwoord op de meest gestelde vragen" subtitle="Veelgestelde vragen" />
</BaseLayout>
