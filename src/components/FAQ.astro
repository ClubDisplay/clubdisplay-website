---
export interface FAQItem {
  q: string;
  a: string;
  html?: string;
}

export interface Props {
  items?: FAQItem[];
  title?: string;
  subtitle?: string;
}

const {
  items: propItems,
  title = "Antwoord op de meest gestelde vragen",
  subtitle = "Veelgestelde vragen",
} = Astro.props;

const defaultItems: FAQItem[] = [
  {
    q: "Wat kost digital signage?",
    a: "De kosten hangen af van het aantal schermen, type hardware, softwarelicentie en eventuele maatwerkcontent. Onze narrowcasting software is beschikbaar vanaf €19 per maand per scherm. Hardware varieert van €899 voor een instapmodel tot €2.500+ voor professionele hospitality displays. We maken altijd een vrijblijvende offerte op maat.",
    html: "De kosten hangen af van het aantal schermen, type hardware, softwarelicentie en eventuele maatwerkcontent. Onze narrowcasting software is beschikbaar vanaf €19 per maand per scherm. Hardware (schermen, beugels, mediaspelers) varieert van €899 voor een instapmodel tot €2.500+ voor professionele hospitality displays van LG of Samsung. We maken altijd een vrijblijvende offerte op maat.",
  },
  {
    q: "Wat heb ik nodig voor digital signage?",
    a: "Je hebt drie dingen nodig: een professioneel scherm, narrowcasting software om content te beheren, en content in je huisstijl. ClubDisplay levert dit compleet: advies, hardware, installatie, vormgeving en support.",
    html: "Je hebt drie dingen nodig: een <strong>professioneel scherm</strong> (geen consumenten-tv), <strong>narrowcasting software</strong> om content te beheren, en <strong>content</strong> in je huisstijl. ClubDisplay levert dit compleet: wij adviseren, selecteren de juiste hardware, installeren alles, verzorgen de vormgeving en blijven beschikbaar voor beheer en support.",
  },
  {
    q: "Kunnen digitale menuborden gekoppeld worden aan een kassasysteem?",
    a: "Ja, dat is een van onze specialismes. We koppelen digitale menuborden aan kassasystemen zodat prijzen, producten en aanbiedingen automatisch worden gesynchroniseerd. Bij een prijswijziging in de kassa wordt het scherm direct bijgewerkt.",
    html: "Ja, dat is een van onze specialismes. We koppelen digitale menuborden aan kassasystemen zodat prijzen, producten en aanbiedingen automatisch worden gesynchroniseerd. Bij een prijswijziging in de kassa wordt het scherm direct bijgewerkt — geen handmatig werk, geen fouten. We hebben ervaring met koppelingen voor diverse kassasystemen in de horeca en retail.",
  },
  {
    q: "Werkt ClubDisplay met LG Pro:Centric?",
    a: "Zeker. ClubDisplay is gespecialiseerd in LG Pro:Centric en officieel partner. Wij leveren, installeren en beheren Pro:Centric systemen voor hotels en andere hospitality-omgevingen.",
    html: "Zeker. ClubDisplay is gespecialiseerd in LG Pro:Centric en officieel partner. Wij leveren, installeren en beheren Pro:Centric systemen voor hotels en andere hospitality-omgevingen. Denk aan maatwerk welkomstberichten, PMS-koppeling, zenderbeheer en integratie met streamingdiensten zoals Netflix en YouTube.",
  },
  {
    q: "Is digital signage geschikt voor coffeeshops?",
    a: "Ja, wij hebben specifieke ervaring met digital signage voor coffeeshops. Denk aan digitale prijslijsten, productinformatie, wachtrijcommunicatie en menuborden, allemaal centraal beheerbaar.",
    html: "Ja, wij hebben specifieke ervaring met digital signage voor coffeeshops. Denk aan digitale prijslijsten, productinformatie, wachtrijcommunicatie en menuborden — allemaal centraal beheerbaar en afgestemd op een professionele, rustige uitstraling. De content is volledig aanpasbaar aan je huisstijl en voldoet aan de geldende richtlijnen.",
  },
  {
    q: "Regelt ClubDisplay ook installatie en beheer?",
    a: "Jazeker. Wij geloven in een compleet zorgeloze ervaring. Onze werkwijze omvat het hele traject: inventarisatie, advies, hardware- en softwarekeuze, installatie, contentontwerp, systeemkoppelingen én doorlopend beheer en support.",
    html: "Jazeker. Wij geloven in een compleet zorgeloze ervaring. Onze werkwijze omvat het hele traject: inventarisatie, advies, hardware- en softwarekeuze, installatie op locatie, contentontwerp, systeemkoppelingen én doorlopend beheer en support. Je hoeft nergens zelf achteraan. Ook na oplevering blijven we beschikbaar voor vragen, updates en onderhoud.",
  },
];

const items = propItems || defaultItems;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": items.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a,
    },
  })),
};
---

<section class="faq" id="faq">
  <div class="container">
    <div class="section-label">{subtitle}</div>
    <h2 class="section-title">{title}</h2>
    <div class="faq-grid">
      {items.map((item) => (
        <details class="faq-item" name="faq">
          <summary class="faq-question">
            <span>{item.q}</span>
            <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </summary>
          <div class="faq-answer">
            <p set:html={item.html || item.a} />
          </div>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  .faq {
    padding: 6rem 0;
    background: var(--bg);
  }
  .section-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }
  .section-title {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 2.5rem;
    line-height: 1.15;
  }
  .faq-grid {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .faq-item {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #fff;
    transition: border-color 0.15s;
  }
  .faq-item[open] { border-color: var(--primary-light); }
  .faq-question {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem;
    padding: 1.125rem 1.5rem;
    font-weight: 600;
    font-size: 0.938rem;
    color: var(--text);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .faq-question::-webkit-details-marker { display: none; }
  .faq-question:hover { color: var(--primary); }
  .faq-chevron {
    flex-shrink: 0;
    transition: transform 0.2s;
    color: var(--text-muted);
  }
  .faq-item[open] .faq-chevron { transform: rotate(90deg); color: var(--primary); }
  .faq-answer {
    padding: 0 1.5rem 1.25rem;
    border-top: 1px solid var(--border-light);
  }
  .faq-answer p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0.75rem 0 0;
  }
  .faq-answer strong { color: var(--text); }

  @media (max-width: 600px) {
    .faq { padding: 3.5rem 0; }
    .section-title { font-size: 1.5rem; }
    .faq-question { font-size: 0.875rem; padding: 1rem 1.25rem; }
    .faq-answer { padding: 0 1.25rem 1rem; }
  }
</style>
