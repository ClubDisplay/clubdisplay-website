---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
interface Props { entry: CollectionEntry<"cases"> }
const { entry } = Astro.props;
const { Content } = await render(entry);
const path = `/project/${entry.id.replace(/\.md$/, "")}/`;
const url = `https://clubdisplay.nl${path}`;
const image = entry.data.image!;
const schema = {
  "@context": "https://schema.org", "@type": "Article",
  headline: entry.data.title, description: entry.data.description, inLanguage: "nl-NL",
  image: `https://clubdisplay.nl${image}`,
  datePublished: entry.data.pubDate.toISOString(), dateModified: entry.data.pubDate.toISOString(),
  author: { "@type": "Organization", name: "ClubDisplay", url: "https://clubdisplay.nl/" },
  publisher: { "@type": "Organization", name: "ClubDisplay", url: "https://clubdisplay.nl/" },
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  about: [{ "@type": "Hotel", name: entry.data.client, url: "https://www.theaterhotel.nl/" }, { "@type": "Thing", name: "LG Pro:Centric Cloud" }],
};
---
<BaseLayout title="Private cinema Van der Valk Almelo | Pro:Centric Cloud" description={entry.data.description} currentPath={path} canonical={url} breadcrumbLabel={entry.data.title} ogImage={`https://clubdisplay.nl${image}`}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article class="editorial-case">
    <header class="case-intro">
      <div class="container intro-grid">
        <div>
          <a class="back" href="/cases/">← Alle cases</a>
          <p class="eyebrow">Hospitality TV · Private cinema</p>
          <h1>{entry.data.title}</h1>
          <p class="lead">{entry.data.intro}</p>
          <p class="published">Gepubliceerd op <time datetime={entry.data.pubDate.toISOString()}>13 november 2026</time></p>
          <a class="btn" href="/plan-jouw-gesprek/">Bespreek uw project</a>
        </div>
        <figure>
          <img src={image} srcset={`${image.replace('.webp', '-900.webp')} 675w, ${image} 1500w`} sizes="(max-width: 800px) 90vw, 460px" alt="Private bioscoop bij Van der Valk Theaterhotel Almelo met het door ClubDisplay ontworpen gastenportaal." width="1500" height="2000" fetchpriority="high" />
          <figcaption>Eigen content op het grote scherm, in de sfeer van The SpareRoom.</figcaption>
        </figure>
      </div>
    </header>
    <div class="case-body container"><Content /></div>
    <footer class="case-contact">
      <div class="container">
        <p class="eyebrow">Van hotelkamer tot private cinema</p>
        <h2>Een gastenportaal dat past bij uw locatie.</h2>
        <p>Bespreek uw wensen voor hospitality-tv, casting en entertainment met ClubDisplay.</p>
        <a class="btn" href="/plan-jouw-gesprek/">Plan een adviesgesprek</a>
      </div>
    </footer>
  </article>
</BaseLayout>
<style>
  .case-intro{padding:64px 0 72px;background:linear-gradient(135deg,#eef6ff,#fff 65%,#eef4fb)}
  .intro-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:64px;align-items:center}
  .back{display:inline-block;margin-bottom:30px;font-size:14px}
  .eyebrow{color:var(--primary);font-size:13px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;margin-bottom:18px}
  h1{font-size:clamp(32px,3.7vw,54px);letter-spacing:-.04em;line-height:1.1;margin-bottom:24px}
  .lead{font-size:19px;line-height:1.75;color:#334155}
  .published{font-size:14px;color:#64748b;margin:22px 0}
  figure{margin:0;max-width:460px}
  figure img{display:block;width:100%;height:auto;border-radius:14px;box-shadow:0 20px 50px #102a5c22}
  figcaption{font-size:13px;line-height:1.6;color:#64748b;margin-top:10px}
  .case-body{max-width:850px;padding-top:64px;padding-bottom:72px}
  .case-body :global(h2){margin:44px 0 18px;font-size:clamp(26px,3vw,34px);line-height:1.2}
  .case-body :global(h3){margin:28px 0 12px;font-size:21px;line-height:1.4}
  .case-body :global(p){font-size:18px;line-height:1.85;margin:0 0 22px;color:#334155}
  .case-body :global(figure){max-width:560px;margin:40px auto}
  .case-body :global(img){display:block;width:100%;height:auto;border-radius:12px}
  .case-body :global(figcaption){font-size:14px;color:#64748b;margin-top:10px;line-height:1.6}
  .case-contact{background:#eff5fc;padding:64px 0}
  .case-contact h2{max-width:760px;font-size:clamp(28px,3.5vw,44px);line-height:1.2;margin-bottom:20px}
  .case-contact p{margin-bottom:24px}
  @media(max-width:800px){.intro-grid{grid-template-columns:1fr;gap:36px}.case-intro{padding:32px 0 44px}.intro-grid figure{max-width:460px;margin:auto}.case-body{padding-top:28px;padding-bottom:40px}.case-body :global(p){font-size:17px}}
</style>
